{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strip": {
      "type": "object",
      "properties": {
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "deps": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "strip",
            "keep"
          ]
        }
      },
      "additionalProperties": false
    },
    "hydrate": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(pre|post)-[a-z]+$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "title": "ProjectConfig",
  "description": "A project's .plainport.toml"
}
