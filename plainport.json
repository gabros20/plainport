{
  "schema": "plainport.json/1",
  "plainport_json": 1,
  "globalOptions": [
    {
      "name": "json",
      "type": "boolean",
      "summary": "Print NDJSON: event lines, then exactly one final envelope"
    },
    {
      "name": "yes",
      "type": "boolean",
      "summary": "Allow a confirm-class command to run"
    },
    {
      "name": "no-input",
      "type": "boolean",
      "summary": "Never prompt; implied when stdin is not a terminal"
    },
    {
      "name": "dry-run",
      "type": "boolean",
      "summary": "Preview only: build and print the plan, change nothing"
    },
    {
      "name": "store",
      "type": "string",
      "summary": "Use this store instead of the default"
    },
    {
      "name": "config",
      "type": "string",
      "summary": "Read this config file instead of the default"
    },
    {
      "name": "quiet",
      "type": "boolean",
      "summary": "Print only results, warnings and errors"
    },
    {
      "name": "verbose",
      "type": "boolean",
      "summary": "Print debug logs too"
    }
  ],
  "commands": [
    {
      "name": "help",
      "summary": "Show every command, or one command's arguments, options and risk class",
      "usage": "plainport help [<command...>]",
      "risk": "read",
      "dryRun": false,
      "positionals": [
        {
          "name": "command",
          "summary": "A command, e.g. version or root add",
          "required": false,
          "variadic": true
        }
      ],
      "options": [],
      "arguments": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "command": {
            "description": "A command, e.g. version or root add",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "topic": {
            "description": "The command asked about; absent for the full list",
            "type": "string"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "usage": {
                  "type": "string"
                },
                "risk": {
                  "type": "string",
                  "enum": [
                    "read",
                    "safe_write",
                    "confirm"
                  ],
                  "title": "RiskClass"
                },
                "dryRun": {
                  "type": "boolean"
                },
                "positionals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "variadic": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name",
                      "summary",
                      "required",
                      "variadic"
                    ],
                    "additionalProperties": {}
                  }
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "boolean",
                          "string"
                        ]
                      },
                      "multiple": {
                        "type": "boolean"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "risk": {
                        "type": "string",
                        "enum": [
                          "read",
                          "safe_write",
                          "confirm"
                        ],
                        "title": "RiskClass"
                      }
                    },
                    "required": [
                      "name",
                      "type",
                      "multiple",
                      "summary"
                    ],
                    "additionalProperties": {}
                  }
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "argv": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "summary": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "argv",
                      "summary"
                    ],
                    "additionalProperties": {}
                  }
                }
              },
              "required": [
                "name",
                "summary",
                "usage",
                "risk",
                "dryRun",
                "positionals",
                "options",
                "examples"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "commands"
        ],
        "additionalProperties": {}
      },
      "plan": null,
      "examples": [
        {
          "argv": [
            "help"
          ],
          "summary": "List every command"
        },
        {
          "argv": [
            "help",
            "version"
          ],
          "summary": "Show one command"
        }
      ]
    },
    {
      "name": "init",
      "summary": "Name this device, set up its roots and record the store snapshots go to",
      "usage": "plainport init [--root <value>...] [--store-path <value>] [--device <value>]",
      "risk": "confirm",
      "dryRun": false,
      "positionals": [],
      "options": [
        {
          "name": "root",
          "type": "string",
          "multiple": true,
          "summary": "A root, as <key>=<path> (repeatable); without one, a TTY offers a scan"
        },
        {
          "name": "store-path",
          "type": "string",
          "multiple": false,
          "summary": "A local folder for the store, e.g. on an external disk; --store names it (default local)"
        },
        {
          "name": "device",
          "type": "string",
          "multiple": false,
          "summary": "This device's name in every root's bindings; default: the host name"
        }
      ],
      "arguments": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "root": {
            "description": "A root, as <key>=<path> (repeatable); without one, a TTY offers a scan",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "store-path": {
            "description": "A local folder for the store, e.g. on an external disk; --store names it (default local)",
            "type": "string",
            "minLength": 1
          },
          "device": {
            "description": "This device's name in every root's bindings; default: the host name",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "created": {
                "type": "boolean",
                "description": "This run created the identity"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "created"
            ],
            "additionalProperties": {}
          },
          "roots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": {}
            }
          },
          "store": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "path"
            ],
            "additionalProperties": {}
          },
          "files": {
            "type": "object",
            "properties": {
              "config": {
                "type": "string"
              },
              "managed": {
                "type": "string"
              },
              "device": {
                "type": "string"
              }
            },
            "required": [
              "config",
              "managed",
              "device"
            ],
            "additionalProperties": {}
          },
          "changed": {
            "type": "boolean",
            "description": "This run wrote managed.toml or created device.json"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$",
                  "title": "FindingCode",
                  "description": "Stable dotted code, e.g. git.unpushed"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warn",
                    "block"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fix": {
                  "description": "The exact next step, e.g. a command to run",
                  "type": "string",
                  "minLength": 1
                },
                "allowable": {
                  "type": "boolean",
                  "description": "May --allow <code> override it?"
                }
              },
              "required": [
                "code",
                "severity",
                "message",
                "allowable"
              ],
              "additionalProperties": {},
              "title": "Finding"
            }
          }
        },
        "required": [
          "device",
          "roots",
          "files",
          "changed",
          "findings"
        ],
        "additionalProperties": {}
      },
      "plan": null,
      "examples": [
        {
          "argv": [
            "init",
            "--root",
            "work=~/work",
            "--store-path",
            "/Volumes/Archive/plainport",
            "--yes"
          ],
          "summary": "Set up without prompts"
        },
        {
          "argv": [
            "init",
            "--yes"
          ],
          "summary": "Re-check setup from the roots and store already configured (on a TTY, asks for what is missing)"
        }
      ]
    },
