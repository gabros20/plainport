#!/bin/sh
# The T2 test environment as code (ADR-0018); see scripts/testenv.ts for the commands and flags.
here="$(dirname "$0")"
command -v bun >/dev/null 2>&1 || {
  echo "scripts/testenv: bun not found; install Bun $(cat "$here/../.bun-version" 2>/dev/null) first (https://bun.sh)" >&2
  exit 1
}
exec bun "$here/testenv.ts" "$@"
