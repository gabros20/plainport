#compdef plainport
# Generated by `bun run contract` from the command registry (packages/cli). Do not edit.
# zsh: put this file, named _plainport, in a folder on $fpath before compinit runs.

_plainport_names() {
  local -a names
  if (( $# == 0 )); then
    names=(
        'help:Show every command, or one command'\''s arguments, options and risk class'
        'init:Name this device, set up its roots and record the store snapshots go to'
        'ls:Every project with its root, state, device, size and last activity'
        'status:One project in detail: its state, head, lease and what to do next'
        'offload:Snapshot a project, verify it and free its folder; --dry-run shows the plan first'
        'onload:Restore a shelved project into place and reinstall its dependencies'
        'hydrate:Install a project'\''s dependencies again with its own package manager (frozen)'
        'dehydrate:Remove a project'\''s installed dependencies (only what a plugin claims and git does not track)'
        'restore:Restore a snapshot side by side into a free path: no lease, no hydration'
        'recover:Settle interrupted operations: roll back what had not committed, finish what had'
        'gc:Delete released trash past its keepLocalFor deadline; --now deletes it early'
        'root:root commands'
        'version:Print plainport'\''s version'
    )
  elif (( $# == 1 )); then
    case "$1" in
    root)
      names=(
        'add:Add a root, optionally with this device'\''s folder for it; the global --store sets its store'
        'bind:Point a root at its folder on this device'
        'list:Show every root, its folder on each device and its state here'
        'scan:Find every project under a root'\''s folder here and register the new ones'
      ) ;;
    esac
  fi
  (( ${#names} )) && _describe -t commands 'plainport command' names
}

_plainport() {
  local cur=${words[CURRENT]}
  local -a typed opts
  typed=(${words[2,CURRENT-1]:#-*})
  local cmd='' used=0
  if (( ${#typed} >= 2 )); then case "${typed[1]} ${typed[2]}" in 'root add'|'root bind'|'root list'|'root scan') cmd="${typed[1]} ${typed[2]}"; used=2 ;; esac; fi
  if [[ -z $cmd ]] && (( ${#typed} >= 1 )); then case "${typed[1]}" in help|init|ls|status|offload|onload|hydrate|dehydrate|restore|recover|gc|version) cmd=${typed[1]}; used=1 ;; esac; fi
  case "$cmd" in
    'help') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'init') opts=(--root --store-path --store-secret --device --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'ls') opts=(--root --local --shelved --sort --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'status') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'offload') opts=(--plan --keep-deps --allow --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'onload') opts=(--to --snapshot --no-hydrate --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'hydrate') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'dehydrate') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'restore') opts=(--to --snapshot --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'recover') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'gc') opts=(--now --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'root add') opts=(--label --create --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'root bind') opts=(--device --create --json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'root list') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'root scan') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'version') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    *) opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help --version) ;;
  esac
  if [[ $cur == -* ]]; then
    compadd -- $opts
  elif [[ -z $cmd ]]; then
    _plainport_names $typed
  elif [[ $cmd == help ]]; then
    _plainport_names ${typed[used+1,-1]}
  else
    _files
  fi
}

_plainport "$@"
