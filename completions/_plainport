#compdef plainport
# Generated by `bun run contract` from the command registry (packages/cli). Do not edit.
# zsh: put this file, named _plainport, in a folder on $fpath before compinit runs.

_plainport_names() {
  local -a names
  if (( $# == 0 )); then
    names=(
        'help:Show every command, or one command'\''s arguments, options and risk class'
        'version:Print plainport'\''s version'
    )
  fi
  (( ${#names} )) && _describe -t commands 'plainport command' names
}

_plainport() {
  local cur=${words[CURRENT]}
  local -a typed opts
  typed=(${words[2,CURRENT-1]:#-*})
  local cmd='' used=0
  if [[ -z $cmd ]] && (( ${#typed} >= 1 )); then case "${typed[1]}" in help|version) cmd=${typed[1]}; used=1 ;; esac; fi
  case "$cmd" in
    'help') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    'version') opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help) ;;
    *) opts=(--json --yes --no-input --dry-run --store --config --quiet --verbose --help --version) ;;
  esac
  if [[ $cur == -* ]]; then
    compadd -- $opts
  elif [[ -z $cmd ]]; then
    _plainport_names $typed
  elif [[ $cmd == help ]]; then
    _plainport_names ${typed[used+1,-1]}
  else
    _files
  fi
}

_plainport "$@"
