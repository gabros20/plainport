{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plainport": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Ulid",
      "description": "A ULID: 26 upper-case Crockford base32 characters"
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "rootId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Ulid",
      "description": "A ULID: 26 upper-case Crockford base32 characters"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!\\.\\.?(?:\\/|$))[^/]+(?:\\/(?!\\.\\.?(?:\\/|$))[^/]+)*$"
    },
    "store": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Ulid",
      "description": "A ULID: 26 upper-case Crockford base32 characters"
    },
    "offloadedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "restore": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "plainport",
    "project",
    "root",
    "rootId",
    "path",
    "store",
    "snapshot",
    "offloadedAt",
    "bytes",
    "restore"
  ],
  "additionalProperties": false,
  "title": "Stub",
  "description": "A .plainport stub left where an offloaded project was"
}
