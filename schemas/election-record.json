{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "candidate",
        "publishing",
        "refused"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "decision"
  ],
  "additionalProperties": false,
  "title": "ElectionRecord",
  "description": "A candidate's record in an elected publication (bootstrap, root claim): its candidacy or its decision"
}
