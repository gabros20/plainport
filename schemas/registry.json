{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "projects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "title": "Ulid",
        "description": "A ULID: 26 upper-case Crockford base32 characters"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!\\.\\.?(?:\\/|$))[^/]+(?:\\/(?!\\.\\.?(?:\\/|$))[^/]+)*$"
          },
          "override": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Ulid",
            "description": "A ULID: 26 upper-case Crockford base32 characters"
          },
          "onloadedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "root",
          "path",
          "registeredAt"
        ],
        "additionalProperties": false
      }
    },
    "roots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "title": "Ulid",
        "description": "A ULID: 26 upper-case Crockford base32 characters"
      }
    },
    "stores": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "title": "Ulid",
        "description": "A ULID: 26 upper-case Crockford base32 characters"
      }
    }
  },
  "required": [
    "v",
    "projects"
  ],
  "additionalProperties": false,
  "title": "ProjectRegistry",
  "description": "registry.json: this device's projects by ULID"
}
