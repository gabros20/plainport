{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "op": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Ulid",
      "description": "A ULID: 26 upper-case Crockford base32 characters"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Ulid",
          "description": "A ULID: 26 upper-case Crockford base32 characters"
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "address"
      ],
      "additionalProperties": false
    },
    "staging": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "v",
    "op",
    "project",
    "staging"
  ],
  "additionalProperties": false,
  "title": "StagingRecord",
  "description": "staging/<op>.json in plainport's state: a restore's staging folder, for gc (D60)"
}
