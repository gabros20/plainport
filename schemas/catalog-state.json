{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "fold": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Ulid",
            "description": "A ULID: 26 upper-case Crockford base32 characters"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                "title": "Ulid",
                "description": "A ULID: 26 upper-case Crockford base32 characters"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!\\.\\.?(?:\\/|$))[^/]+(?:\\/(?!\\.\\.?(?:\\/|$))[^/]+)*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "local",
                  "shelved",
                  "conflicted"
                ]
              },
              "head": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                    "title": "Ulid",
                    "description": "A ULID: 26 upper-case Crockford base32 characters"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "heads": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                  "title": "Ulid",
                  "description": "A ULID: 26 upper-case Crockford base32 characters"
                }
              },
              "lease": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "device": {
                        "type": "string",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                        "title": "Ulid",
                        "description": "A ULID: 26 upper-case Crockford base32 characters"
                      },
                      "event": {
                        "type": "string",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                        "title": "Ulid",
                        "description": "A ULID: 26 upper-case Crockford base32 characters"
                      },
                      "base": {
                        "type": "string",
                        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                        "title": "Ulid",
                        "description": "A ULID: 26 upper-case Crockford base32 characters"
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      }
                    },
                    "required": [
                      "device",
                      "event",
                      "base",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                    "title": "Ulid",
                    "description": "A ULID: 26 upper-case Crockford base32 characters"
                  }
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                  "title": "Ulid",
                  "description": "A ULID: 26 upper-case Crockford base32 characters"
                }
              },
              "discarded": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                  "title": "Ulid",
                  "description": "A ULID: 26 upper-case Crockford base32 characters"
                }
              },
              "snapshots": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                  "title": "Ulid",
                  "description": "A ULID: 26 upper-case Crockford base32 characters"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "offloaded",
                        "checkpointed"
                      ]
                    },
                    "base": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                      "title": "Ulid",
                      "description": "A ULID: 26 upper-case Crockford base32 characters"
                    },
                    "event": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                      "title": "Ulid",
                      "description": "A ULID: 26 upper-case Crockford base32 characters"
                    },
                    "device": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                      "title": "Ulid",
                      "description": "A ULID: 26 upper-case Crockford base32 characters"
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "stored": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "event",
                    "device",
                    "at",
                    "stored"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "root",
              "path",
              "status",
              "head",
              "heads",
              "lease",
              "conflicts",
              "missing",
              "discarded",
              "snapshots"
            ],
            "additionalProperties": false
          }
        },
        "roots": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "title": "Ulid",
            "description": "A ULID: 26 upper-case Crockford base32 characters"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "key": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "type": "string"
              },
              "created": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                    "title": "Ulid",
                    "description": "A ULID: 26 upper-case Crockford base32 characters"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bindings": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                  "title": "Ulid",
                  "description": "A ULID: 26 upper-case Crockford base32 characters"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string",
                      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
                      "title": "Ulid",
                      "description": "A ULID: 26 upper-case Crockford base32 characters"
                    }
                  },
                  "required": [
                    "path",
                    "event"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "created",
              "bindings"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "projects",
        "roots"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$",
            "title": "FindingCode",
            "description": "Stable dotted code, e.g. git.unpushed"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "block"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "description": "The exact next step, e.g. a command to run",
            "type": "string",
            "minLength": 1
          },
          "allowable": {
            "type": "boolean",
            "description": "May --allow <code> override it?"
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "allowable"
        ],
        "additionalProperties": {},
        "title": "Finding"
      }
    }
  },
  "required": [
    "v",
    "fold",
    "digest",
    "count",
    "state",
    "findings"
  ],
  "additionalProperties": false,
  "title": "CatalogStateCache",
  "description": "state.json beside a store's or a mirror's events: a rebuildable cache of the catalog fold"
}
